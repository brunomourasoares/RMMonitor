<Window x:Class="RMMonitor.MainWindow"
        Icon="/Resources/Images/rise-mode.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:RMMonitor.Controls"
        Title="RM Monitor"
        Height="900"
        Width="1480"
        MinHeight="700"
        MinWidth="1040"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Styles/DashboardStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    <Storyboard x:Key="IntroStoryboard">
      <DoubleAnimation Storyboard.TargetName="MainContent"
                       Storyboard.TargetProperty="Opacity"
                       From="0"
                       To="1"
                       Duration="0:0:0.65"/>
      <DoubleAnimation Storyboard.TargetName="IntroTransform"
                       Storyboard.TargetProperty="Y"
                       From="18"
                       To="0"
                       Duration="0:0:0.65">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="AmbientGlow"
                       Storyboard.TargetProperty="Opacity"
                       From="0.22"
                       To="0.52"
                       Duration="0:0:3"
                       AutoReverse="True"
                       RepeatBehavior="Forever"/>
    </Storyboard>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="42"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
      <Grid Margin="16,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Border Width="22"
                  Height="22"
                  CornerRadius="6">
            <TextBlock Text="RM"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="8"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="RM MONITOR"
                     FontSize="11"
                     FontWeight="Bold"
                     Margin="9,0,0,0"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Button Width="38"
                  Height="30"
                  Click="MinimizeWindow_Click"
                  ToolTip="Minimize"
                  AutomationProperties.Name="Minimize"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource WindowControlButton}"
                  Padding="7">
            <Viewbox Width="10"
                     Height="10">
              <Canvas Width="10"
                      Height="10">
                <Path Data="M0,5 H10 V6 H0 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </Canvas>
            </Viewbox>
          </Button>
          <Button Width="38"
                  Height="30"
                  Click="MaximizeWindow_Click"
                  ToolTip="Maximize / Restore"
                  AutomationProperties.Name="Maximize / Restore"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Style="{StaticResource WindowControlButton}"
                  Padding="7">
            <Grid Width="12"
                  Height="12">
              <Viewbox x:Name="MaximizeGlyph">
                <Canvas Width="10"
                        Height="10">
                  <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1"
                        Fill="Transparent"/>
                </Canvas>
              </Viewbox>
              <Viewbox x:Name="RestoreGlyph"
                       Visibility="Collapsed"
                       Width="16"
                       Height="16">
                <Canvas Width="16"
                        Height="16">
                  <Path Data="M5.5,3.5 H12.5 V10.5"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1"
                        Fill="Transparent"/>
                  <Path Data="M3.5,5.5 H10.5 V12.5 H3.5 V5.5 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1"
                        Fill="Transparent"/>
                </Canvas>
              </Viewbox>
            </Grid>
          </Button>
          <Button Width="38"
                  Height="30"
                  Click="CloseWindow_Click"
                  ToolTip="Close"
                  AutomationProperties.Name="Close"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CloseWindowControlButton}"
                  Padding="7">
            <Viewbox Width="10"
                     Height="10">
              <Canvas Width="10"
                      Height="10">
                <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1"/>
              </Canvas>
            </Viewbox>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1"
          Margin="20,12,20,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="226"/>
        <ColumnDefinition Width="22"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="1"
              CornerRadius="22"
              Padding="16">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal"
                        Margin="5,4,0,30">
              <Border Width="42"
                      Height="42"
                      CornerRadius="14"
                      BorderBrush="{DynamicResource AccentLineBrush}"
                      BorderThickness="1"
                      Padding="5">
                <Image Source="/Resources/Images/rise-mode.png"
                       Stretch="Uniform"
                       AutomationProperties.Name="Rise Mode logo"/>
              </Border>
              <StackPanel VerticalAlignment="Center"
                          Margin="11,0,0,0">
                <TextBlock Text="RM MONITOR"
                           FontSize="15"
                           FontWeight="Bold"/>
                <TextBlock Text="RISE MODE HARDWARE MONITOR"
                           FontSize="9"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Text="WORKSPACE"
                       Style="{StaticResource SmallLabel}"
                       Margin="8,0,0,10"/>
            <Button x:Name="NavOverviewButton"
                    Click="NavOverview_Click"
                    Style="{StaticResource NavButton}"
                    Background="{DynamicResource PanelRaisedBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Margin="0,0,0,4">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="◫"
                           FontSize="17"
                           Width="29"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Overview"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavCoolingButton"
                    Click="NavCooling_Click"
                    Style="{StaticResource NavButton}"
                    Margin="0,0,0,4">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="◉"
                           FontSize="17"
                           Width="29"/>
                <TextBlock Text="Cooling"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavHardwareButton"
                    Click="NavHardware_Click"
                    Style="{StaticResource NavButton}"
                    Margin="0,0,0,4">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="▦"
                           FontSize="17"
                           Width="29"/>
                <TextBlock Text="Hardware"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavSettingsButton"
                    Click="NavSettings_Click"
                    Style="{StaticResource NavButton}"
                    Margin="0,0,0,4">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙"
                           FontSize="16"
                           Width="29"/>
                <TextBlock Text="Settings"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Border Height="1"
                    Background="{DynamicResource StrokeBrush}"
                    Margin="4,22,4,20"/>
            <TextBlock Text="DISPLAY DEVICE"
                       Style="{StaticResource SmallLabel}"
                       Margin="8,0,0,12"/>
            <Border Background="{DynamicResource PanelRaisedBrush}"
                    CornerRadius="12"
                    Padding="11">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="DisplayConnectionIndicator"
                           Width="7"
                           Height="7"
                           Fill="{DynamicResource WarningBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                  <TextBlock x:Name="DisplayConnectionTitleText"
                             Text="Waiting for device"
                             FontSize="11"
                             FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="DisplayConnectionStatusText"
                           Text="USB / HID connection not enabled"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom"
                      Margin="0,20,0,0">

            <StackPanel Orientation="Horizontal"
                        Margin="6,16,0,2">
              <Border Width="27"
                      Height="27"
                      CornerRadius="9">
                <TextBlock Text="RM"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="9,0,0,0"
                          VerticalAlignment="Center">
                <TextBlock Text="RM Monitor"
                           FontSize="11"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Preview build · .NET 10"
                           FontSize="9"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="2"
                    x:Name="MainScrollViewer"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="MainContent"
              Height="{Binding ViewportHeight, ElementName=MainScrollViewer}"
              Opacity="0"
              RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform>
            <TranslateTransform x:Name="IntroTransform"
                                Y="18"/>
          </Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0"
                Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
              <TextBlock Text="System overview"
                         FontSize="29"
                         FontWeight="Bold"/>
              <TextBlock Text="Your hardware, at a glance."
                         FontSize="13"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
              <TextBlock Text="WATER COOLER MODEL"
                         Style="{StaticResource SmallLabel}"
                         Margin="0,0,0,5"/>
              <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="CoolerModelSelector"
                          ToolTip="Changes the preview appearance only; it does not control the hardware."
                          Width="300"
                          Height="34"
                          SelectedIndex="0"
                          SelectionChanged="CoolerModelSelector_SelectionChanged"
                          FontSize="11"
                          Style="{StaticResource ThemedComboBox}"
                          ItemContainerStyle="{StaticResource ThemedComboBoxItem}">
                  <ComboBoxItem Content="Aura Ice ARGB 120mm" Tag="RM-WAI-01-ARGB|white|display|auraice|argb"/>
                  <ComboBoxItem Content="Aura Ice ARGB 240mm" Tag="RM-WAI-02-ARGB|white|display|auraice|argb"/>
                  <ComboBoxItem Content="Aura Ice ARGB 360mm" Tag="RM-WAI-03-ARGB|white|display|auraice|argb"/>
                  <ComboBoxItem Content="Aura Ice Black ARGB 120mm" Tag="RM-WAIB-04-ARGB|black|display|auraice|argb"/>
                  <ComboBoxItem Content="Aura Ice Black ARGB 240mm" Tag="RM-WAIB-05-ARGB|black|display|auraice|argb"/>
                  <ComboBoxItem Content="Aura Ice Black ARGB 360mm" Tag="RM-WAIB-06-ARGB|black|display|auraice|argb"/>
                  <ComboBoxItem Content="Frost RGB 120mm" Tag="RM-WCZ-01-RGB|white|plain|classic|rgb"/>
                  <ComboBoxItem Content="Frost RGB 240mm" Tag="RM-WCZ-02-RGB|white|plain|classic|rgb"/>
                  <ComboBoxItem Content="Frost RGB 360mm" Tag="RM-WCF-04-RGB|white|plain|classic|rgb"/>
                  <ComboBoxItem Content="Black RGB 120mm" Tag="RM-WCB-01-RGB|black|plain|classic|rgb"/>
                  <ComboBoxItem Content="Black RGB 240mm" Tag="RM-WCB-02-RGB|black|plain|classic|rgb"/>
                  <ComboBoxItem Content="Black RGB 360mm" Tag="RM-WCB-03-RGB|black|plain|classic|rgb"/>
                  <ComboBoxItem Content="Black ARGB 240mm" Tag="RM-WCB-04-ARGB|black|plain|classic|argb"/>
                  <ComboBoxItem Content="Black ARGB 120mm" Tag="RM-WCB-05-ARGB|black|plain|classic|argb"/>
                  <ComboBoxItem Content="Black ARGB 360mm" Tag="RM-WCB-07-ARGB|black|plain|classic|argb"/>
                  <ComboBoxItem Content="Frost ARGB 120mm" Tag="RM-WCZ-05-ARGB|white|plain|classic|argb"/>
                  <ComboBoxItem Content="Aura Frost Pro ARGB 240mm" Tag="RM-WCZ-06-ARGB|white|plain|classic|argb"/>
                  <ComboBoxItem Content="Aura Frost Pro ARGB 360mm" Tag="RM-WCF-07-ARGB|white|plain|classic|argb"/>
                  <ComboBoxItem Content="All Black 240mm" Tag="RM-WC-AB-240|black|plain|allblack|none"/>
                  <ComboBoxItem Content="All Black 360mm" Tag="RM-WC-AB-360|black|plain|allblack|none"/>
                </ComboBox>
              </StackPanel>
            </StackPanel>
          </Grid>
          <controls:DashboardMetricsControl x:Name="DashboardMetrics" Grid.Row="1"/>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border x:Name="TemperatureHistoryCard"
                      Grid.Row="0"
                      Style="{StaticResource CardStyle}"
                      ClipToBounds="True">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Temperature"
                                 FontSize="17"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="Live temperature history"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <CheckBox x:Name="TemperatureCpuFilter"
                                Content="CPU"
                                IsChecked="True"
                                Checked="HistoryFilter_Changed"
                                Unchecked="HistoryFilter_Changed"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                FontSize="10"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"/>
                      <CheckBox x:Name="TemperatureGpuFilter"
                                Content="GPU"
                                IsChecked="True"
                                Checked="HistoryFilter_Changed"
                                Unchecked="HistoryFilter_Changed"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                FontSize="10"
                                VerticalAlignment="Center"/>
                      </StackPanel>
                      <Button x:Name="SaveTemperatureHistoryButton" Content="Export CSV" Click="SaveHistory_Click" HorizontalAlignment="Right" Margin="0,7,0,0" Padding="10,4" FontSize="10" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource StrokeBrush}"/>
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Row="1"
                        Margin="0,15,0,10">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="35"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="100°"
                               Grid.Row="0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="9"
                               VerticalAlignment="Top"/>
                    <TextBlock Text="75°"
                               Grid.Row="1"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="9"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="50°"
                               Grid.Row="2"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="9"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="25°"
                               Grid.Row="3"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="9"
                               VerticalAlignment="Bottom"/>
                    <controls:TemperatureHistoryChart x:Name="TemperatureHistoryChart" Grid.Column="1" Grid.RowSpan="4"/>
                  </Grid>
                  <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Rolling 30 minutes · data since launch"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0"/><TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource GpuGreenBrush}" Margin="0,0,4,0"/><TextBlock Text="GPU" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
              <Border Grid.Row="2"
                      Style="{StaticResource CardStyle}"
                      ClipToBounds="True">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Utilization"
                                 FontSize="17"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="Live utilization history"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <CheckBox x:Name="UtilizationCpuFilter"
                                Content="CPU"
                                IsChecked="True"
                                Checked="HistoryFilter_Changed"
                                Unchecked="HistoryFilter_Changed"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                FontSize="10"
                                VerticalAlignment="Center"
                                Margin="0,0,9,0"/>
                      <CheckBox x:Name="UtilizationGpuFilter"
                                Content="GPU"
                                IsChecked="True"
                                Checked="HistoryFilter_Changed"
                                Unchecked="HistoryFilter_Changed"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                FontSize="10"
                                VerticalAlignment="Center"
                                Margin="0,0,9,0"/>
                      <CheckBox x:Name="UtilizationRamFilter"
                                Content="RAM"
                                IsChecked="True"
                                Checked="HistoryFilter_Changed"
                                Unchecked="HistoryFilter_Changed"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                FontSize="10"
                                VerticalAlignment="Center"/>
                      </StackPanel>
                      <Button x:Name="SaveUtilizationHistoryButton" Content="Export CSV" Click="SaveHistory_Click" HorizontalAlignment="Right" Margin="0,7,0,0" Padding="10,4" FontSize="10" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource StrokeBrush}"/>
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Row="1"
                        Margin="0,15,0,10">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="35"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="100%"
                               Grid.Row="0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="9"
                               VerticalAlignment="Top"/>
                    <TextBlock Text="75%"
                               Grid.Row="1"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="9"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="50%"
                               Grid.Row="2"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="9"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="25%"
                               Grid.Row="3"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="9"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="0%"
                               Grid.Row="4"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="9"
                               VerticalAlignment="Bottom"/>
                    <controls:UtilizationHistoryChart x:Name="UtilizationHistoryChart" Grid.Column="1" Grid.RowSpan="5"/>
                  </Grid>
                  <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Rolling 30 minutes · data since launch" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0"/><TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"><Ellipse Width="7" Height="7" Fill="{DynamicResource GpuGreenBrush}" Margin="0,0,4,0"/><TextBlock Text="GPU" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource PurpleBrush}" Margin="0,0,4,0"/><TextBlock Text="RAM" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border x:Name="CoolerCard"
                      Grid.Row="0"
                      Style="{StaticResource CardStyle}"
                      ClipToBounds="True">
                <Grid>
                  <Ellipse x:Name="AmbientGlow"
                           Width="205"
                           Height="205"
                           Fill="{DynamicResource AccentSoftBrush}"
                           Opacity="0.3"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <Ellipse.Effect>
                      <BlurEffect Radius="40"/>
                    </Ellipse.Effect>
                  </Ellipse>
                  <StackPanel VerticalAlignment="Top">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Water Cooler"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Pump display preview"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                      </StackPanel>
                      <Border Grid.Column="1"
                              BorderBrush="{DynamicResource StrokeBrush}"
                              BorderThickness="1"
                              CornerRadius="9"
                              Padding="8,5">
                        <TextBlock x:Name="CoolerModelBadge"
                                   Text="Aura Ice ARGB 120mm"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="180"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"/>
                      </Border>
                    </Grid>
                  </StackPanel>
                  <controls:CoolerBlockView x:Name="CoolerPreview"
                                            Margin="8,36,8,4"/>
                </Grid>
              </Border>
              <Border x:Name="ThermalComponentsCard" Grid.Row="2" Style="{StaticResource CardStyle}" ClipToBounds="True">
                <controls:FrequencyPanelControl x:Name="FrequencyPanel"/>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </ScrollViewer>
    </Grid>
    <Grid Grid.RowSpan="2"
          x:Name="SettingsDialogOverlay"
          Visibility="Collapsed"
          Panel.ZIndex="100"
          Background="{DynamicResource ScrimBrush}">
      <Border Width="430"
              MaxWidth="430"
              Padding="24"
              CornerRadius="18"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel>
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="SYSTEM SETTINGS"
                         Style="{StaticResource SmallLabel}"/>
              <TextBlock Text="Preferences"
                         FontSize="22"
                         FontWeight="SemiBold"
                         Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="✕"
                    ToolTip="Close settings"
                    AutomationProperties.Name="Close settings"
                    Width="30"
                    Height="30"
                    Click="CloseSettingsDialog_Click"
                    Background="Transparent"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    Cursor="Hand"/>
          </Grid>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Interface theme"
                         FontSize="12"
                         FontWeight="SemiBold"/>
              <TextBlock Text="Choose light or dark appearance"
                         FontSize="10"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,3,0,0"/>
            </StackPanel>
            <ComboBox x:Name="ThemeSelector"
                      Grid.Column="1"
                      SelectedIndex="0"
                      SelectionChanged="ThemeSelector_SelectionChanged"
                      Height="32"
                      FontSize="11"
                      Style="{StaticResource ThemedComboBox}"
                      ItemContainerStyle="{StaticResource ThemedComboBoxItem}">
              <ComboBoxItem Content="Dark"/>
              <ComboBoxItem Content="Light"/>
            </ComboBox>
          </Grid>
          <Border Height="1"
                  Background="{DynamicResource StrokeBrush}"
                  Margin="0,0,0,12"/>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Refresh rate"
                         FontSize="12"
                         FontWeight="SemiBold"/>
              <TextBlock Text="Sensor polling interval"
                         FontSize="10"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,3,0,0"/>
            </StackPanel>
            <ComboBox x:Name="PollIntervalSelector"
                      Grid.Column="1"
                      SelectedIndex="1"
                      SelectionChanged="PollIntervalSelector_SelectionChanged"
                      Height="32"
                      FontSize="11"
                      Style="{StaticResource ThemedComboBox}"
                      ItemContainerStyle="{StaticResource ThemedComboBoxItem}">
              <ComboBoxItem Content="1 sec"/>
              <ComboBoxItem Content="2 sec"/>
              <ComboBoxItem Content="5 sec"/>
            </ComboBox>
          </Grid>
          <Border Height="1"
                  Background="{DynamicResource StrokeBrush}"
                  Margin="0,0,0,12"/>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="History retention"
                         FontSize="12"
                         FontWeight="SemiBold"/>
              <TextBlock Text="How long to keep telemetry locally"
                         FontSize="10"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,3,0,0"/>
            </StackPanel>
            <ComboBox x:Name="HistoryRetentionSelector"
                      Grid.Column="1"
                      SelectedIndex="0"
                      SelectionChanged="HistoryRetentionSelector_SelectionChanged"
                      Height="32"
                      FontSize="11"
                      Style="{StaticResource ThemedComboBox}"
                      ItemContainerStyle="{StaticResource ThemedComboBoxItem}">
              <ComboBoxItem Content="30 minutes"/>
              <ComboBoxItem Content="1 hour"/>
              <ComboBoxItem Content="6 hours"/>
              <ComboBoxItem Content="24 hours"/>
            </ComboBox>
          </Grid>
          <Border Height="1"
                  Background="{DynamicResource StrokeBrush}"
                  Margin="0,0,0,12"/>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Minimize to tray on close"
                         FontSize="12"
                         FontWeight="SemiBold"/>
              <TextBlock Text="Keep RM Monitor running in the notification area"
                         FontSize="10"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,3,0,0"/>
            </StackPanel>
            <CheckBox x:Name="CloseToTrayCheckBox"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Checked="CloseToTrayCheckBox_Changed"
                      Unchecked="CloseToTrayCheckBox_Changed"
                      Margin="12,0,4,0"/>
          </Grid>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Start with Windows"
                         FontSize="12"
                         FontWeight="SemiBold"/>
              <TextBlock Text="Launch automatically in the tray when you sign in"
                         FontSize="10"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,3,0,0"/>
            </StackPanel>
            <CheckBox x:Name="StartWithWindowsCheckBox"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Checked="StartWithWindowsCheckBox_Changed"
                      Unchecked="StartWithWindowsCheckBox_Changed"
                      Margin="12,0,4,0"/>
          </Grid>
          <Border Height="1"
                  Background="{DynamicResource StrokeBrush}"
                  Margin="0,0,0,12"/>
          <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Language"
                         FontSize="12"
                         FontWeight="SemiBold"/>
              <TextBlock Text="Application display language"
                         FontSize="10"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,3,0,0"/>
            </StackPanel>
            <ComboBox x:Name="LanguageSelector"
                      Grid.Column="1"
                      SelectedIndex="1"
                      SelectionChanged="LanguageSelector_SelectionChanged"
                      Height="32"
                      FontSize="11"
                      Style="{StaticResource ThemedComboBox}"
                      ItemContainerStyle="{StaticResource ThemedComboBoxItem}">
              <ComboBoxItem Content="English"/>
              <ComboBoxItem Content="Português"/>
              <ComboBoxItem Content="Español"/>
              <ComboBoxItem Content="Italiano"/>
              <ComboBoxItem Content="Français"/>
              <ComboBoxItem Content="简体中文"/>
            </ComboBox>
          </Grid>
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right">
            <Button Content="Close"
                    Click="CloseSettingsDialog_Click"
                    MinWidth="92"
                    Height="34"
                    Padding="12,4"
                    Background="{DynamicResource PanelRaisedBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
