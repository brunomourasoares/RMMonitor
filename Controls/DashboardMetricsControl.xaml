<UserControl x:Class="RMMonitor.Controls.DashboardMetricsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RMMonitor.Controls">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Styles/DashboardStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UniformGrid
                       Columns="4"
                       Margin="0,0,0,18">
            <Border Style="{StaticResource MetricCard}"
                    Margin="0,0,10,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="CPU"
                             Style="{StaticResource SmallLabel}"/>
                  <TextBlock x:Name="CpuModelTextElement"
                             Text="Detecting processor..."
                             FontSize="9"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextTrimming="CharacterEllipsis"
                             Margin="0,4,0,0"/>
                  <TextBlock x:Name="CpuTempTextElement"
                             Text="--°"
                             FontSize="29"
                             FontWeight="Bold"
                             Margin="0,12,0,1"/>
                  <TextBlock x:Name="CpuLoadTextElement"
                             Text="Utilization --%"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Width="35"
                        Height="35"
                        CornerRadius="11"
                        VerticalAlignment="Top">
                  <Viewbox Width="21"
                           Height="21">
                    <Canvas Width="24"
                            Height="24">
                      <Path Data="M5,6 C5,5.45 5.45,5 6,5 L18,5 C18.55,5 19,5.45 19,6 L19,18 C19,18.55 18.55,19 18,19 L6,19 C5.45,19 5,18.55 5,18 Z M9,9 L15,9 L15,15 L9,15 Z M3,10 L5,10 M3,14 L5,14 M10,3 L10,5 M14,3 L14,5 M19,10 L21,10 M19,14 L21,14 M10,19 L10,21 M14,19 L14,21"
                            Stroke="{DynamicResource AccentBrush}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Fill="Transparent"/>
                    </Canvas>
                  </Viewbox>
                </Border>
              </Grid>
            </Border>
            <Border Style="{StaticResource MetricCard}"
                    Margin="0,0,10,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="GPU"
                             Style="{StaticResource SmallLabel}"/>
                  <TextBlock x:Name="GpuModelTextElement"
                             Text="Detecting graphics..."
                             FontSize="9"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextTrimming="CharacterEllipsis"
                             Margin="0,4,0,0"/>
                  <TextBlock x:Name="GpuTempTextElement"
                             Text="--°"
                             FontSize="29"
                             FontWeight="Bold"
                             Margin="0,12,0,1"/>
                  <TextBlock x:Name="GpuLoadTextElement"
                             Text="Utilization --%"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Width="35"
                        Height="35"
                        CornerRadius="11"
                        VerticalAlignment="Top">
                  <Viewbox Width="21"
                           Height="21">
                    <Canvas Width="24"
                            Height="24">
                      <Path Data="M3,4 L3,18 M3,6 L20,6 Q21,6 21,7 L21,15 Q21,16 20,16 L3,16 M9,13 A2,2 0 1 0 9,9 A2,2 0 1 0 9,13 M15,9 L15,13 M18,9 L18,13 M7,16 L7,19 L15,19 L15,16"
                            Stroke="{DynamicResource GpuGreenBrush}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Fill="Transparent"/>
                    </Canvas>
                  </Viewbox>
                </Border>
              </Grid>
            </Border>
            <Border Style="{StaticResource MetricCard}"
                    Margin="0,0,10,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="MEMORY"
                             Style="{StaticResource SmallLabel}"/>
                  <TextBlock Text="Memory model unavailable"
                             FontSize="9"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Margin="0,4,0,0"/>
                  <TextBlock x:Name="MemoryTextElement"
                             Text="--%"
                             FontSize="29"
                             FontWeight="Bold"
                             Margin="0,12,0,1"/>
                  <TextBlock x:Name="MemoryPercentTextElement"
                             Text="Waiting for memory data"
                             FontSize="10"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             Margin="0,3,0,7"/>
                  <ProgressBar x:Name="MemoryUsageBarElement"
                               Height="5"
                               Maximum="100"
                               Value="0"
                               Foreground="{DynamicResource PurpleBrush}"
                               Background="{DynamicResource PanelRaisedBrush}"
                               BorderThickness="0"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Width="35"
                        Height="35"
                        CornerRadius="11"
                        VerticalAlignment="Top">
                  <Viewbox Width="21"
                           Height="21">
                    <Canvas Width="24"
                            Height="24">
                      <Path Data="M12,11 L12,13 M16,11 L16,13 M3,7 L21,7 Q22,7 22,8 L22,9 Q22,10 21,10 Q20,10 20,11 L20,13 Q20,14 21,14 Q22,14 22,15 L22,17 Q22,18 21,18 L3,18 Q2,18 2,17 L2,15 Q2,14 3,14 Q4,14 4,13 L4,11 Q4,10 3,10 Q2,10 2,9 L2,8 Q2,7 3,7 Z M8,11 L8,13 M4,18 L4,20 M7,18 L7,20 M10,18 L10,20 M13,18 L13,20 M17,18 L17,20 M20,18 L20,20"
                            Stroke="{DynamicResource PurpleBrush}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Fill="Transparent"/>
                    </Canvas>
                  </Viewbox>
                </Border>
              </Grid>
            </Border>
            <Border Style="{StaticResource MetricCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="STORAGE"
                             Style="{StaticResource SmallLabel}"/>
                  <TextBlock x:Name="StorageModelTextElement"
                             Text="Detecting drive..."
                             FontSize="9"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextTrimming="CharacterEllipsis"
                             Margin="0,4,0,0"/>
                  <StackPanel Orientation="Horizontal"
                              Margin="0,8,0,1">
                    <TextBlock x:Name="StorageUsedPercentTextElement"
                               Text="--%"
                               FontSize="29"
                               FontWeight="Bold"/>
                  </StackPanel>
                  <TextBlock x:Name="StorageCapacityTextElement"
                             Text="Waiting for disk data"
                             FontSize="10"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             Margin="0,2,0,7"/>
                  <TextBlock x:Name="StorageVolumesTextElement"
                             Text="Storage volumes will appear here."
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="9"
                             Margin="0,0,0,7"/>
                  <ProgressBar x:Name="StorageUsageBarElement"
                               Height="5"
                               Maximum="100"
                               Value="0"
                               Foreground="{DynamicResource WarningBrush}"
                               Background="{DynamicResource PanelRaisedBrush}"
                               BorderThickness="0"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Width="35"
                        Height="35"
                        CornerRadius="11"
                        VerticalAlignment="Top">
                  <Viewbox Width="21"
                           Height="21">
                    <Canvas Width="24"
                            Height="24">
                      <Path Data="M10,16 L10.01,16 M2.212,11.577 A2,2 0 0 0 2,12.473 L2,18 A2,2 0 0 0 4,20 L20,20 A2,2 0 0 0 22,18 L22,12.473 A2,2 0 0 0 21.788,11.577 L18.55,5.11 A2,2 0 0 0 16.76,4 L7.24,4 A2,2 0 0 0 5.45,5.11 Z M21.946,12.013 L2.054,12.013 M6,16 L6.01,16"
                            Stroke="{DynamicResource WarningBrush}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Fill="Transparent"/>
                    </Canvas>
                  </Viewbox>
                </Border>
              </Grid>
            </Border>
          </UniformGrid>
</UserControl>
