<UserControl x:Class="RMMonitor.Controls.FrequencyHistoryChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True"
             Focusable="False">
  <Canvas x:Name="ChartCanvas"
          Height="92"
          ClipToBounds="True"
          SizeChanged="ChartCanvas_SizeChanged">
    <Path x:Name="CpuFrequencyLine"
          Stroke="{DynamicResource AccentBrush}"
          StrokeThickness="2"
          StrokeLineJoin="Round"
          StrokeStartLineCap="Round"
          StrokeEndLineCap="Round"/>
    <Path x:Name="GpuFrequencyLine"
          Stroke="{DynamicResource GpuGreenBrush}"
          StrokeThickness="2"
          StrokeLineJoin="Round"
          StrokeStartLineCap="Round"
          StrokeEndLineCap="Round"/>
  </Canvas>
</UserControl>
