<UserControl x:Class="RMMonitor.Controls.TemperatureHistoryChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True"
             Focusable="False">
  <Viewbox Stretch="Fill" ClipToBounds="True">
    <Canvas x:Name="ThermalChartCanvas"
            Width="900"
            Height="136"
            ClipToBounds="True">
      <Line X1="0" Y1="8" X2="900" Y2="8"
            Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" StrokeDashArray="3 5"/>
      <Line X1="0" Y1="48" X2="900" Y2="48"
            Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" StrokeDashArray="3 5"/>
      <Line X1="0" Y1="88" X2="900" Y2="88"
            Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" StrokeDashArray="3 5"/>
      <Line X1="0" Y1="128" X2="900" Y2="128"
            Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" StrokeDashArray="3 5"/>
      <Path x:Name="CpuHistoryPath"
            Stroke="{DynamicResource AccentBrush}"
            StrokeThickness="2.5"
            StrokeLineJoin="Round"
            Fill="{x:Null}"/>
      <Path x:Name="GpuHistoryPath"
            Stroke="{DynamicResource GpuGreenBrush}"
            StrokeThickness="2"
            StrokeLineJoin="Round"
            Fill="{x:Null}"
            Opacity="0.9"/>
    </Canvas>
  </Viewbox>
</UserControl>
